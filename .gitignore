# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments and tool caches
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local editor settings
.vscode/

# mkdocs build output
site/

# benchmarks/run.py writes here by default; results are cited by command and commit, never tracked
benchmarks/results/

# Local, untracked project data: the licensed weights (both forms: `models/` matches only a directory), upstream
# reference checkouts, scratch output
models
models/
references
temp/

# Agent settings: the shared settings, rules and skills are tracked, the rest is per machine
.claude/*
!.claude/settings.json
!.claude/rules/
!.claude/skills/

# Agent task scratch
trash/
agent_notes/
